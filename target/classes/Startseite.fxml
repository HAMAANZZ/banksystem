<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="sceneStartseite" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- ListView mit Kontextmenü -->
        <ListView fx:id="listViewAcconts" layoutX="14.0" layoutY="14.0" prefHeight="586.0" prefWidth="253.0">
            <contextMenu>
                <ContextMenu fx:id="contextMenu">
                    <items>
                        <MenuItem fx:id="menuAuswaehlen" text="Auswählen" />
                        <MenuItem fx:id="menuLoeschen" text="Löschen" />
                    </items>
                </ContextMenu>
            </contextMenu>
        </ListView>
        <!-- Button -->
        <Button fx:id="AccountErstellen" layoutX="350.0" layoutY="257.0" mnemonicParsing="false" prefHeight="101.0" prefWidth="166.0" text="Account Erstellen" />
    </children>
</AnchorPane>
