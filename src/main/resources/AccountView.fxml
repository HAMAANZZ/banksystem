<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="sceneAccountview" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- ListView mit dem eingebetteten ContextMenu -->
        <ListView fx:id="TrasaktionenListeView" layoutX="14.0" layoutY="75.0" prefHeight="390.0" prefWidth="572.0">
            <contextMenu>
                <ContextMenu fx:id="contextMenu">
                    <items>
                        <MenuItem fx:id="menuSortAscending" text="Aufsteigende Sortierung" />
                        <MenuItem fx:id="menuSortDescending" text="Absteigende Sortierung" />
                        <MenuItem fx:id="menuShowPositive" text="Nur positive Beträge" />
                        <MenuItem fx:id="menuShowNegative" text="Nur negative Beträge" />
                        <MenuItem fx:id="menuLoeschen" text="Löschen" />
                    </items>
                </ContextMenu>
            </contextMenu>
        </ListView>

        <!-- Button -->
        <Button fx:id="BackKnopf" layoutX="14.0" layoutY="480.0" mnemonicParsing="false" prefHeight="100.0" prefWidth="190.0" text="Back-Button" />
      <Label fx:id="AccountDetails" layoutX="14.0" layoutY="14.0" prefHeight="56.0" prefWidth="572.0" text="AccountDetails" />
      <Button fx:id="PaymentErstellen" layoutX="204.0" layoutY="480.0" mnemonicParsing="false" prefHeight="100.0" prefWidth="190.0" text="PaymentErstellen" />
      <Button fx:id="TransferErstellen" layoutX="394.0" layoutY="480.0" mnemonicParsing="false" prefHeight="100.0" prefWidth="190.0" text="TransferErstellen" />
    </children>
</AnchorPane>
